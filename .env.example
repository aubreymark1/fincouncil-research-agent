# Copy to .env locally or on the server only. Never commit .env.
# For sslip.io, replace dots in the public IP with dashes.
DEMO_HOST=your-subdomain.example.sslip.io

# LLM demo mode is off by default. Set true only when all model vars are filled.
FINCOUNCIL_ENABLE_LLM_DEMO=false

# DeepSeek demo runtime (only read server-side from .env)
FINCOUNCIL_MODEL_PROVIDER=deepseek
FINCOUNCIL_MODEL_NAME=deepseek-v4-flash
FINCOUNCIL_MODEL_BASE_URL=https://api.deepseek.com
# Leave empty unless AI enhanced demo is intended.
FINCOUNCIL_MODEL_API_KEY=
FINCOUNCIL_MODEL_TEMPERATURE=0
FINCOUNCIL_MODEL_MAX_RETRIES=1
FINCOUNCIL_MODEL_TIMEOUT_SECONDS=120

# Simple per-IP rate limit for POST /api/runs
FINCOUNCIL_MAX_RUNS_PER_IP_PER_MINUTE=10
